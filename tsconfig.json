{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vitest/globals"], "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts", "tests/integration/**/*.ts", "vitest.config.ts"]
}

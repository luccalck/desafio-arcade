{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "levels"
  ],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/level"
      }
    }
  },
  "definitions": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "advance",
                "left",
                "right",
                "collect",
                "activate"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "times",
            "body"
          ],
          "properties": {
            "kind": {
              "const": "repeat"
            },
            "times": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "enum": [
                  "advance",
                  "left",
                  "right",
                  "collect",
                  "activate"
                ]
              }
            }
          }
        }
      ]
    },
    "object": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "x",
            "y",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "kind": {
              "enum": [
                "terminal",
                "gate"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "x",
            "y",
            "kind",
            "signal"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "kind": {
              "const": "switch"
            },
            "signal": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        }
      ]
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "concept",
        "objective",
        "briefing",
        "hints",
        "lesson",
        "grid",
        "start",
        "goal",
        "maxBlocks",
        "maxSteps",
        "allowRepeat",
        "allowedActions",
        "requiredPackets",
        "requiresCircuit",
        "objects",
        "initialProgram",
        "solution",
        "hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "concept": {
          "type": "string",
          "minLength": 3
        },
        "objective": {
          "type": "string",
          "minLength": 10
        },
        "briefing": {
          "type": "string",
          "minLength": 10
        },
        "hint": {
          "type": "string",
          "minLength": 10
        },
        "lesson": {
          "type": "string",
          "minLength": 10
        },
        "hints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "grid": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[.#]{2,8}$"
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "direction"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "direction": {
              "enum": [
                "north",
                "east",
                "south",
                "west"
              ]
            }
          }
        },
        "goal": {
          "$ref": "#/definitions/position"
        },
        "maxBlocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "allowRepeat": {
          "type": "boolean"
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "advance",
              "left",
              "right",
              "collect",
              "activate"
            ]
          }
        },
        "requiredPackets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "requiresCircuit": {
          "type": "boolean"
        },
        "objects": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/object"
          }
        },
        "initialProgram": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/command"
          }
        },
        "solution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/command"
          }
        }
      }
    }
  }
}

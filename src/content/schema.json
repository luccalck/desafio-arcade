{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "predicate"
            },
            "name": {
              "enum": [
                "valid",
                "permission",
                "credentials",
                "enoughEnergy",
                "maintenance",
                "countMet",
                "lotDone"
              ]
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "and",
                "or"
              ]
            },
            "left": {
              "$ref": "#/$defs/expr"
            },
            "right": {
              "$ref": "#/$defs/expr"
            }
          },
          "required": [
            "kind",
            "left",
            "right"
          ]
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "action"
            },
            "action": {
              "enum": [
                "power",
                "sensor",
                "read",
                "report",
                "charge",
                "process",
                "resetCount",
                "count",
                "send",
                "review",
                "allow",
                "deny",
                "release",
                "hold"
              ]
            }
          },
          "required": [
            "kind",
            "action"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/expr"
            },
            "then": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "action"
                  },
                  "action": {
                    "enum": [
                      "power",
                      "sensor",
                      "read",
                      "report",
                      "charge",
                      "process",
                      "resetCount",
                      "count",
                      "send",
                      "review",
                      "allow",
                      "deny",
                      "release",
                      "hold"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "action"
                ]
              }
            },
            "else": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "action"
                  },
                  "action": {
                    "enum": [
                      "power",
                      "sensor",
                      "read",
                      "report",
                      "charge",
                      "process",
                      "resetCount",
                      "count",
                      "send",
                      "review",
                      "allow",
                      "deny",
                      "release",
                      "hold"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "action"
                ]
              }
            }
          },
          "required": [
            "kind",
            "condition",
            "then",
            "else"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "foreach"
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "action"
                      },
                      "action": {
                        "enum": [
                          "power",
                          "sensor",
                          "read",
                          "report",
                          "charge",
                          "process",
                          "resetCount",
                          "count",
                          "send",
                          "review",
                          "allow",
                          "deny",
                          "release",
                          "hold"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "action"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "if"
                      },
                      "condition": {
                        "$ref": "#/$defs/expr"
                      },
                      "then": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "action"
                            },
                            "action": {
                              "enum": [
                                "power",
                                "sensor",
                                "read",
                                "report",
                                "charge",
                                "process",
                                "resetCount",
                                "count",
                                "send",
                                "review",
                                "allow",
                                "deny",
                                "release",
                                "hold"
                              ]
                            }
                          },
                          "required": [
                            "kind",
                            "action"
                          ]
                        }
                      },
                      "else": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "action"
                            },
                            "action": {
                              "enum": [
                                "power",
                                "sensor",
                                "read",
                                "report",
                                "charge",
                                "process",
                                "resetCount",
                                "count",
                                "send",
                                "review",
                                "allow",
                                "deny",
                                "release",
                                "hold"
                              ]
                            }
                          },
                          "required": [
                            "kind",
                            "action"
                          ]
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "condition",
                      "then",
                      "else"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "kind",
            "body"
          ]
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]+$",
          "maxLength": 48
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 650
        },
        "energy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "charge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "targetEnergy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "packets": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]+$",
                "maxLength": 48
              },
              "valid": {
                "type": "boolean"
              },
              "permission": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "valid",
              "permission"
            ]
          }
        },
        "credentials": {
          "type": "boolean"
        },
        "maintenance": {
          "type": "boolean"
        },
        "targetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "id",
        "label",
        "energy",
        "charge",
        "cost",
        "targetEnergy",
        "packets",
        "credentials",
        "maintenance",
        "targetCount"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "missions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$",
            "maxLength": 48
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "reward": {
            "enum": [
              100,
              200
            ]
          },
          "mode": {
            "enum": [
              "sequence",
              "variables",
              "conditions",
              "boolean",
              "loop",
              "final"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          },
          "lessons": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 650
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 650
                }
              },
              "required": [
                "title",
                "text"
              ]
            }
          },
          "hints": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 650
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "power",
                "sensor",
                "read",
                "report",
                "charge",
                "process",
                "resetCount",
                "count",
                "send",
                "review",
                "allow",
                "deny",
                "release",
                "hold"
              ]
            }
          },
          "predicates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "valid",
                "permission",
                "credentials",
                "enoughEnergy",
                "maintenance",
                "countMet",
                "lotDone"
              ]
            }
          },
          "hasIf": {
            "type": "boolean"
          },
          "hasLoop": {
            "type": "boolean"
          },
          "hasGroup": {
            "type": "boolean"
          },
          "maxBlocks": {
            "type": "integer",
            "minimum": 4,
            "maximum": 20
          },
          "solution": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/block"
            },
            "minItems": 1
          },
          "initialPractice": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "demo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "$ref": "#/$defs/scenario"
              },
              "program": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/block"
                },
                "minItems": 1
              }
            },
            "required": [
              "scenario",
              "program"
            ]
          },
          "practice": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/scenario"
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/scenario"
            }
          }
        },
        "required": [
          "id",
          "title",
          "concept",
          "icon",
          "reward",
          "mode",
          "goal",
          "brief",
          "lessons",
          "hints",
          "actions",
          "predicates",
          "hasIf",
          "hasLoop",
          "hasGroup",
          "maxBlocks",
          "solution",
          "initialPractice",
          "demo",
          "practice",
          "scenarios"
        ]
      }
    }
  },
  "required": [
    "missions"
  ]
}

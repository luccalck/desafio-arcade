{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missions"
  ],
  "properties": {
    "missions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "concept",
          "goal",
          "help",
          "functionName",
          "starter",
          "reference",
          "cases",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^workshop-[a-z]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "help": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "functionName": {
            "enum": [
              "controlar",
              "mover",
              "colidir",
              "pontuar",
              "criarOnda",
              "final"
            ]
          },
          "starter": {
            "type": "string",
            "maxLength": 6000
          },
          "reference": {
            "type": "string",
            "maxLength": 6000
          },
          "reward": {
            "type": "integer",
            "enum": [
              100,
              200
            ]
          },
          "cases": {
            "type": "array",
            "maxItems": 20,
